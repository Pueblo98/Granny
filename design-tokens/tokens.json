  "semantic": {
    "$comment": "Meaning-bearing roles. Component styles reference ONLY these. Every color role carries a per-theme alias into primitive.",

    "surface.canvas": { "type": "color", "status": "proposed", "role": "Screen background behind everything", "themes": { "open-day": "{color.openDay.green.050}", "bright-signal": "{color.brightSignal.blue.050}" } },
    "surface.panel": { "type": "color", "status": "proposed", "role": "Content surface holding private task content", "themes": { "open-day": "{color.neutral.white}", "bright-signal": "{color.neutral.white}" } },
    "surface.selected": { "type": "color", "status": "proposed-new", "role": "Selected row/choice fill. Never the only selection signal — a check mark and spoken state always accompany it.", "themes": { "open-day": "{color.openDay.green.100}", "bright-signal": "{color.brightSignal.blue.100}" } },
    "surface.pressed": { "type": "color", "status": "proposed-new", "role": "Pressed fill for rows and low-emphasis controls whose label is text.primary. Secondary buttons do NOT use this — they invert to action.secondary on press, because the secondary label misses 7:1 against this tint (measured 5.93:1 open-day).", "themes": { "open-day": "{color.openDay.green.150}", "bright-signal": "{color.brightSignal.blue.150}" } },
    "surface.disabled": { "type": "color", "status": "proposed-new", "role": "Disabled control fill. The adjacent reason text uses text.secondary at full contrast, never text.disabled.", "themes": { "open-day": "{color.openDay.surface.disabled}", "bright-signal": "{color.brightSignal.surface.disabled}" } },

    "text.primary": { "type": "color", "status": "proposed", "role": "Essential text: headings, body, action labels, status", "themes": { "open-day": "{color.openDay.ink.900}", "bright-signal": "{color.brightSignal.ink.900}" } },
    "text.secondary": { "type": "color", "status": "proposed", "role": "Supporting text and disabled explanations", "themes": { "open-day": "{color.openDay.ink.600}", "bright-signal": "{color.brightSignal.ink.600}" } },
    "text.disabled": { "type": "color", "status": "proposed-new", "role": "Label of a disabled control ONLY. The reason why it is disabled is never rendered in this role.", "themes": { "open-day": "{color.openDay.ink.500}", "bright-signal": "{color.brightSignal.ink.500}" } },
    "text.on-primary": { "type": "color", "status": "proposed", "role": "Text/icon on action.primary", "themes": { "open-day": "{color.neutral.white}", "bright-signal": "{color.neutral.white}" } },
    "text.on-danger": { "type": "color", "status": "proposed", "role": "Text/icon on status.danger", "themes": { "open-day": "{color.neutral.white}", "bright-signal": "{color.neutral.white}" } },
    "text.on-accent": { "type": "color", "status": "proposed-new", "role": "Text on accent.decorative. Accent may only carry text that also passes essential contrast.", "themes": { "open-day": "{color.openDay.ink.900}", "bright-signal": "{color.brightSignal.ink.900}" } },

    "action.primary": { "type": "color", "status": "proposed", "role": "One primary next action per decision region. Send uses this role with explicit wording — sending is NOT danger.", "themes": { "open-day": "{color.openDay.green.900}", "bright-signal": "{color.brightSignal.blue.800}" } },
    "action.primary.hover": { "type": "color", "status": "proposed-new", "role": "Pointer hover on primary. Android has no hover; this exists for the web specimen and keyboard/pointer review only.", "themes": { "open-day": "{color.openDay.green.950}", "bright-signal": "{color.brightSignal.blue.900}" } },
    "action.primary.pressed": { "type": "color", "status": "proposed-new", "role": "Pressed primary. Pressed changes fill, never position.", "themes": { "open-day": "{color.openDay.green.980}", "bright-signal": "{color.brightSignal.blue.950}" } },
    "action.secondary": { "type": "color", "status": "proposed", "role": "Secondary action text and outline", "themes": { "open-day": "{color.openDay.green.700}", "bright-signal": "{color.brightSignal.violet.700}" } },
    "accent.decorative": { "type": "color", "status": "proposed", "role": "Decorative punctuation ONLY. Must never be a warning background, a default action fill, or carry essential text that fails 7:1.", "themes": { "open-day": "{color.openDay.amber.500}", "bright-signal": "{color.brightSignal.yellow.400}" } },

    "border.control": { "type": "color", "status": "proposed-new", "role": "Essential control boundary (target ≥3:1 against both adjacent surfaces)", "themes": { "open-day": "{color.openDay.ink.600}", "bright-signal": "{color.brightSignal.ink.600}" } },
    "border.subtle": { "type": "color", "status": "proposed-new", "role": "Decorative grouping rule. Carries no essential meaning and is exempt from the 3:1 boundary target.", "themes": { "open-day": "{color.openDay.rule.200}", "bright-signal": "{color.brightSignal.rule.200}" } },
    "border.disabled": { "type": "color", "status": "proposed-new", "role": "Boundary of a disabled control. A disabled control keeps a measurable outline — its fill is never the only thing marking where it is.", "themes": { "open-day": "{color.openDay.rule.500}", "bright-signal": "{color.brightSignal.rule.500}" } },
    "border.selected": { "type": "color", "status": "proposed-new", "role": "Boundary of a selected row or choice. Selection is carried by check mark + label + this boundary; the tinted fill alone never signals it.", "themes": { "open-day": "{color.openDay.green.900}", "bright-signal": "{color.brightSignal.blue.800}" } },

    "status.success": { "type": "color", "status": "proposed", "role": "Verified-complete outcome. Always paired with icon and words, drawn as a rule beside content on surface.panel — status blocks carry no tinted fill.", "themes": { "open-day": "{color.openDay.success.700}", "bright-signal": "{color.brightSignal.success.700}" } },
    "status.warning": { "type": "color", "status": "proposed", "role": "Consequence warning and unknown-outcome text/icon/rule", "themes": { "open-day": "{color.openDay.warning.800}", "bright-signal": "{color.brightSignal.warning.800}" } },
    "status.danger": { "type": "color", "status": "proposed", "role": "Deletion and high-consequence removal only", "themes": { "open-day": "{color.openDay.danger.700}", "bright-signal": "{color.brightSignal.danger.700}" } },

    "focus.ring": { "type": "color", "status": "proposed", "role": "Focus indicator, never clipped by a card", "themes": { "open-day": "{color.openDay.violet.700}", "bright-signal": "{color.brightSignal.violet.800}" } },
    "focus.separation": { "type": "color", "status": "proposed-new", "role": "Gap colour between control edge and focus ring", "themes": { "open-day": "{color.neutral.white}", "bright-signal": "{color.neutral.white}" } },

    "radius.small": { "type": "dimension", "unit": "dp", "status": "proposed", "themes": { "open-day": 8, "bright-signal": 4 } },
    "radius.control": { "type": "dimension", "unit": "dp", "status": "proposed", "role": "Buttons, fields, switches", "themes": { "open-day": 12, "bright-signal": 8 } },
    "radius.container": { "type": "dimension", "unit": "dp", "status": "proposed", "role": "Panels and grouped regions", "themes": { "open-day": 16, "bright-signal": 8 } },
    "radius.dialog": { "type": "dimension", "unit": "dp", "status": "proposed", "themes": { "open-day": 16, "bright-signal": 8 } },

    "font.family.display": { "type": "fontFamily", "status": "proposed", "themes": { "open-day": "\"Atkinson Hyperlegible Next\"", "bright-signal": "\"Manrope\"" } },
    "font.family.body": { "type": "fontFamily", "status": "proposed", "themes": { "open-day": "\"Atkinson Hyperlegible Next\"", "bright-signal": "\"Source Sans 3\"" } },

    "space.inset.nominal": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.5}", "role": "Nominal screen inset" },
    "space.inset.narrow": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.4}", "role": "Narrow-width screen inset" },
    "space.gap.primary-targets": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.3}", "role": "Minimum gap between two distinct primary targets" },
    "space.gap.label-icon": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.2}", "role": "Internal label/icon gap" },
    "space.stack.tight": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.2}" },
    "space.stack.default": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.4}" },
    "space.stack.loose": { "type": "dimension", "unit": "dp", "status": "proposed", "value": "{space.6}" },

    "size.target.min": { "type": "dimension", "unit": "dp", "status": "proposed", "value": 56, "role": "Minimum interactive target (A11Y-03)" },
    "size.target.primary": { "type": "dimension", "unit": "dp", "status": "proposed", "value": 64, "role": "Primary, Stop and consequential action minimum height (A11Y-03)" },

    "focus.ring.width": { "type": "dimension", "unit": "dp", "status": "proposed", "value": 3 },
    "focus.ring.offset": { "type": "dimension", "unit": "dp", "status": "proposed", "value": 2 },
    "stroke.icon.min": { "type": "dimension", "unit": "dp", "status": "proposed", "value": 2, "role": "Icon stroke floor" },
    "stroke.icon.max": { "type": "dimension", "unit": "dp", "status": "proposed", "value": 2.5, "role": "Icon stroke ceiling" },

    "motion.press": { "type": "duration", "unit": "ms", "status": "proposed", "value": "{duration.press}" },
    "motion.state": { "type": "duration", "unit": "ms", "status": "proposed", "value": "{duration.state}" },
    "motion.panel": { "type": "duration", "unit": "ms", "status": "proposed", "value": "{duration.panel}" },
    "motion.reduced": { "type": "duration", "unit": "ms", "status": "proposed", "value": "{duration.instant}", "role": "Reduced motion replaces every duration above with an immediate static state change" },
    "motion.easing.standard": { "type": "cubicBezier", "status": "proposed", "value": "cubic-bezier(0.2, 0, 0, 1)", "role": "Settles directly; no overshoot, no bounce, no infinite decorative pulse" }
  },

  "typography": {
    "$comment": "Sizes are proposed Android sp. The web specimen maps 1sp -> 1px at TextScale 1.0 for review only; CSS px is NOT proof of Android sp conformance. Values scale with user/system preference and are never capped.",
