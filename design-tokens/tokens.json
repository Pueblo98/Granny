    "heading":      { "size": 28, "lineHeight": 36, "weight": 600, "family": "display", "unit": "sp", "status": "proposed", "role": "Section heading" },
    "body-large":   { "size": 24, "lineHeight": 34, "weight": 400, "family": "body",    "unit": "sp", "status": "proposed", "role": "Preview body and other close-reading content" },
    "body":         { "size": 20, "lineHeight": 30, "weight": 400, "family": "body",    "unit": "sp", "status": "proposed", "role": "Default reading size" },
    "button":       { "size": 20, "lineHeight": 28, "weight": 600, "family": "body",    "unit": "sp", "status": "proposed", "role": "Action labels" },
    "status":       { "size": 20, "lineHeight": 28, "weight": 600, "family": "body",    "unit": "sp", "status": "proposed", "role": "Outcome and activity status" },
    "supporting":   { "size": 18, "lineHeight": 26, "weight": 400, "family": "body",    "unit": "sp", "status": "proposed", "role": "Metadata and secondary detail" }
  },

  "scales": {
    "textScale": { "$comment": "In-app TextScale, multiplied on top of system font scale. System scaling is never overridden downward.", "status": "proposed", "options": [ { "value": 1.0, "label": "Standard" }, { "value": 1.15, "label": "Larger" }, { "value": 1.3, "label": "Larger still" }, { "value": 1.5, "label": "Largest" } ] },
    "speechRate": { "$comment": "Relative to provider normal. User previews the voice before saving; unsupported rates are explained, never silently substituted.", "status": "proposed", "options": [0.75, 1.0, 1.25, 1.5] }
  },

